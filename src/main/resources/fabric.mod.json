{
    "schemaVersion": 1,
    "id": "boslib",
    "version": "${version}",
    "name": "BosLib",
    "description": "Mod-library for my (_BENDY659_) projects",
    "authors": [ "_BENDY659_" ],
    "contact": {},
    "license": "MIT",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [ { "adapter": "kotlin", "value": "ru.benos.boslib.loaders.FabricModLoader" } ],
        "client": [ { "adapter": "kotlin","value": "ru.benos.boslib.client.BosLibClient" } ]
    },
    "mixins": [ "boslib.mixins.json" ],
    "accessWidener": "boslib.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${mc_compat}",
        "java": ">=21",
        "fabric-language-kotlin": ">=1.13.0"
    }
}
